    class Task {
        +str title
        +str task_type
        +int duration
        +str priority
        +str time
        +str frequency
        +bool completed
        +date due_date
        +mark_completed() None
        +update(fields) dict
    }

    class Pet {
        +str pet_id
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +get_tasks() list~Task~
        +remove_task(task) bool
    }

